# ==============================================================================
# Server & Cloud Run Configuration
# ==============================================================================
# PORT is automatically injected by Google Cloud Run (default 8080 in Cloud Run, 3000 local)
PORT="3000"
NODE_ENV="development"
LOG_FORMAT="pretty"

# ==============================================================================
# Gemini AI API (Store in Google Secret Manager for Cloud Run)
# ==============================================================================
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ==============================================================================
# Telegram Bot & HTTPS Webhook Configuration (Store secrets in Secret Manager)
# ==============================================================================
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# Mode: "auto" (webhook in production/Cloud Run, polling locally), "webhook", or "polling"
TELEGRAM_MODE="auto"

# Full HTTPS Cloud Run URL (or base URL; /telegram/webhook will be appended if omitted)
TELEGRAM_WEBHOOK_URL="https://mr-hany-bot-xxxxxxxxxx-uc.a.run.app/telegram/webhook"

# Strong random secret (32+ chars) passed to Telegram setWebhook secret_token
# Verified on X-Telegram-Bot-Api-Secret-Token header via timingSafeEqual
TELEGRAM_WEBHOOK_SECRET="YOUR_STRONG_RANDOM_WEBHOOK_SECRET_MIN_32_CHARS"

# Telegram files above this size are rejected before download (20 MiB default).
TELEGRAM_MAX_FILE_BYTES="20971520"

# Automatically register Telegram webhook on Cloud Run container startup when true
TELEGRAM_AUTO_SET_WEBHOOK="true"

# Keep webhook processing inside the request so request-based free hosts retain CPU
# while Gemini works. Very long jobs may exceed Telegram's delivery timeout.
WEBHOOK_EXECUTION_MODE="sync"

# Free-tier guard: use Gemini's free model fallback list and disable paid-tier grounding.
GEMINI_FREE_TIER_ONLY="true"

# Optional multi-instance distributed deduplication in Firestore via Cloud Run Service Account
ENABLE_FIRESTORE_DEDUP="false"

# ==============================================================================
# Admin & Persistence
# ==============================================================================
# Generate with: openssl rand -hex 32. Set in the host's secret manager, not Git.
ADMIN_SECRET="REPLACE_WITH_64_HEX_CHAR_SECRET"
# For non-Google hosts (such as Oracle VM), set base64-encoded service-account JSON.
# On Cloud Run, grant the service account roles/datastore.user instead.
GOOGLE_SERVICE_ACCOUNT_JSON_B64=""
DATABASE_URL="postgresql://hany_admin:password@localhost:5432/mr_hany_db?schema=public"
REDIS_URL="redis://localhost:6379"
APP_URL="MY_APP_URL"
